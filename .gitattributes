# Keep manifest-covered text bytes consistent across Windows and Linux.
* text=auto
LICENSE text eol=lf
*.md text eol=lf
*.py text eol=lf
*.json text eol=lf
*.txt text eol=lf
*.html text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
.nojekyll text eol=lf
*.pdf -text
