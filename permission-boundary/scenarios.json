    {
      "id": "P01",
      "case": "Exact live read grant",
      "request": {
        "action": "read",
        "resource": "artifact:demo/report"
      },
      "context": {
        "principal": "operator-a",
        "grants": [
          {
            "id": "g1",
            "principal": "operator-a",
            "action": "read",
            "resource": "artifact:demo/report",
            "expires_at": 2000
          }
        ],
        "revoked": [],
        "approvals": [],
        "now": 1000
      },
      "expected_allow": true,
      "expected_reason": "ALLOW"
    },
    {
